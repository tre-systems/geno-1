digraph AudioGraph {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.55",
    nodesep="0.5",
    ranksep="0.7",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    forcelabels=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Audio Graph</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="15" COLOR="#357a74">Three spatial note voices plus a warm composed sculpture bed, with reverb / delay sends and mastered output.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t,
    labeljust=c
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.2,0.12",
    width=2.55,
    height=0.68,
    fixedsize=false,
    fontname="Avenir",
    fontsize=17,
    penwidth=2.4,
    fontcolor="#14213d",
    color="#0f766e",
    fillcolor="#e6fffb:#ffffff",
    gradientangle=270
  ];

  edge [
    color="#235e58",
    fontname="Avenir",
    fontsize=13,
    fontcolor="#3d4a5c",
    penwidth=2.2,
    arrowsize=0.78
  ];

  // ---- Source (engine, host-testable) ----
  ENG [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Audio scheduler → engine.step</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">NoteEvent (voice, freq, vel, dur),<BR/>scheduled on the audio clock</FONT></TD></TR></TABLE>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];

  // ---- Per-voice strip ----
  subgraph cluster_voice {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#0f766e"><B>PER-NOTE STRIP</B></FONT></TD></TR></TABLE>>,
      labelloc=t, labeljust=l, color="#99d5cf", fillcolor="#f0fdfa", style="rounded,filled", penwidth=1.8, margin=18
    ];
    OSC [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>OscillatorNode</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">per-voice waveform</FONT></TD></TR></TABLE>>];
    ENV [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>GainNode (env)</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">attack / release</FONT></TD></TR></TABLE>>];
    VG  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Voice gain</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">distance level</FONT></TD></TR></TABLE>>];
    PAN [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>PannerNode</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">HRTF positional</FONT></TD></TR></TABLE>>];
    OSC -> ENV -> VG -> PAN;
  }

  // ---- Persistent sculpture layer ----
  subgraph cluster_sculpture {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#0f766e"><B>SCULPTURE LAYER</B></FONT></TD></TR></TABLE>>,
      labelloc=t, labeljust=l, color="#99d5cf", fillcolor="#f0fdfa", style="rounded,filled", penwidth=1.8, margin=18
    ];
    PAD [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Pad oscillators x3</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">just-tuned low chord</FONT></TD></TR></TABLE>>];
    LFO [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Analog drift LFOs</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">audio-rate detune wobble</FONT></TD></TR></TABLE>>, style="rounded,filled,dashed"];
    PLP [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Pad tone filters</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">lowpass + mid dip</FONT></TD></TR></TABLE>>];
    SUB [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Sub sine</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">centred low end</FONT></TD></TR></TABLE>>];
    NOI [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Noise bed</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">brown-weighted wash</FONT></TD></TR></TABLE>>];
    STR [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Starfield x5</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">low consonant harmonics</FONT></TD></TR></TABLE>>];
    SHM [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Octave shimmer</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">dark waveshaped sheen</FONT></TD></TR></TABLE>>];
    FP  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Field pan</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">scripted / swirl bias</FONT></TD></TR></TABLE>>];
    LFO -> PAD [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#dfe3e9" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#6b7280">detune</FONT></TD></TR></TABLE>>, style=dashed, color="#6b7280", fontcolor="#6b7280"];
    PAD -> PLP -> FP;
    STR -> FP;
    PLP -> SHM;
  }

  // ---- Delay bus ----
  subgraph cluster_delay {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#0f766e"><B>DELAY BUS</B></FONT></TD></TR></TABLE>>,
      labelloc=t, labeljust=l, color="#99d5cf", fillcolor="#f0fdfa", style="rounded,filled", penwidth=1.8, margin=18
    ];
    DS [label=<<B>Delay send</B>>];
    DL [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>DelayNode</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">0.55 s</FONT></TD></TR></TABLE>>];
    LT [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Delay tone filters</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">lowpass + mid dip</FONT></TD></TR></TABLE>>];
    DF [label=<<B>Delay feedback</B>>];
    DW [label=<<B>Delay wet</B>>];
    DS -> DL -> LT;
    LT -> DF -> DL [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">feedback</FONT></TD></TR></TABLE>>];
    LT -> DW;
  }

  // ---- Reverb bus ----
  subgraph cluster_reverb {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#0f766e"><B>REVERB BUS</B></FONT></TD></TR></TABLE>>,
      labelloc=t, labeljust=l, color="#99d5cf", fillcolor="#f0fdfa", style="rounded,filled", penwidth=1.8, margin=18
    ];
    RS [label=<<B>Reverb send</B>>];
    CV [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>ConvolverNode</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">7 s procedural IR</FONT></TD></TR></TABLE>>];
    RT [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Reverb tone filters</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">lowpass + mid dip</FONT></TD></TR></TABLE>>];
    RW [label=<<B>Reverb wet</B>>];
    RS -> CV -> RT -> RW;
  }

  // ---- Master + saturation ----
  subgraph cluster_master {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#0f766e"><B>MASTER + SATURATION</B></FONT></TD></TR></TABLE>>,
      labelloc=t, labeljust=l, color="#99d5cf", fillcolor="#f0fdfa", style="rounded,filled", penwidth=1.8, margin=18
    ];
    MAS [label=<<B>Master gain</B>>, penwidth=3.0];
    SP  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Sat pre</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">seed-shaped drive</FONT></TD></TR></TABLE>>];
    WS  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>WaveShaperNode</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">tanh drive</FONT></TD></TR></TABLE>>];
    SW  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Sat wet</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">slow wander</FONT></TD></TR></TABLE>>];
    SD  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Sat dry</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">complement</FONT></TD></TR></TABLE>>];
    OP  [label=<<B>Output pre</B>>];
    CMP [label=<<B>Dynamics compressor</B>>];
    MAS -> SP -> WS -> SW;
    MAS -> SD;
    SW -> OP;
    SD -> OP;
    OP -> CMP;
  }

  // ---- Outputs ----
  DEST [label=<<B>AudioContext.destination</B>>, fillcolor="#d8f5de:#effcf2", color="#15803d", penwidth=3.0];
  AN   [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>AnalyserNode</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="14">optional, drives visuals</FONT></TD></TR></TABLE>>, fillcolor="#edf7ff:#ffffff", color="#2f80ed"];

  // ---- Cross-cluster wiring ----
  ENG -> OSC [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">spawn at scheduled time</FONT></TD></TR></TABLE>>, lhead=cluster_voice];
  PAD -> MAS [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">bed</FONT></TD></TR></TABLE>>, ltail=cluster_sculpture, lhead=cluster_master];
  SUB -> MAS [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">sub</FONT></TD></TR></TABLE>>, ltail=cluster_sculpture, lhead=cluster_master];
  NOI -> MAS [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">noise</FONT></TD></TR></TABLE>>, ltail=cluster_sculpture, lhead=cluster_master];
  FP  -> MAS [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">field</FONT></TD></TR></TABLE>>, ltail=cluster_sculpture, lhead=cluster_master];
  SHM -> RS  [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#dfe3e9" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#6b7280">shimmer send</FONT></TD></TR></TABLE>>, style=dashed, color="#6b7280", fontcolor="#6b7280", ltail=cluster_sculpture, lhead=cluster_reverb];
  PAN -> MAS [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#d7dee8" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#3d4a5c">dry voice</FONT></TD></TR></TABLE>>, lhead=cluster_master];
  ENV -> DS  [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#dfe3e9" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#6b7280">send</FONT></TD></TR></TABLE>>, style=dashed, color="#6b7280", fontcolor="#6b7280", lhead=cluster_delay];
  ENV -> RS  [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#dfe3e9" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#6b7280">send</FONT></TD></TR></TABLE>>, style=dashed, color="#6b7280", fontcolor="#6b7280", lhead=cluster_reverb];
  DW  -> MAS [ltail=cluster_delay, lhead=cluster_master];
  RW  -> MAS [ltail=cluster_reverb, lhead=cluster_master];
  CMP -> DEST;
  MAS -> AN [label=<<TABLE BORDER="1" CELLBORDER="0" STYLE="ROUNDED" COLOR="#dfe3e9" BGCOLOR="#ffffff" CELLSPACING="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="13" COLOR="#6b7280">tap</FONT></TD></TR></TABLE>>, style=dashed, color="#6b7280", fontcolor="#6b7280", constraint=false];
}
