digraph FramePipeline {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.55",
    nodesep="0.5",
    ranksep="0.6",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    forcelabels=true,
    fontname="Avenir",
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
        <TR><TD><FONT POINT-SIZE="34"><B>Scheduler &amp; Frame Loops</B></FONT></TD></TR>
        <TR><TD><FONT POINT-SIZE="15" COLOR="#4e7a61">Two loops: a setInterval audio scheduler (audio clock) and the requestAnimationFrame render frame.</FONT></TD></TR>
      </TABLE>
    >,
    labelloc=t,
    labeljust=c
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.2,0.12",
    width=2.8,
    height=0.62,
    fixedsize=false,
    fontname="Avenir",
    fontsize=17,
    penwidth=2.4,
    fontcolor="#14213d",
    color="#2264c7",
    fillcolor="#eaf3ff:#ffffff",
    gradientangle=270
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=13,
    fontcolor="#3d4a5c",
    penwidth=2.2,
    arrowsize=0.78
  ];

  // ---- Input (event closures enqueue; never mutate state) ----
  subgraph cluster_input {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#1e6b43"><B>INPUT (event closures)</B></FONT></TD></TR></TABLE>>,
      labelloc=t, labeljust=l, color="#b8e5c8", fillcolor="#f4fbf6", style="rounded,filled", penwidth=1.8, margin=18
    ];
    K [label=<<B>keydown</B><BR/><FONT POINT-SIZE="14">command_for_key</FONT>>, fillcolor="#eaf8ef:#ffffff", color="#22865a"];
    P [label=<<B>pointer</B><BR/><FONT POINT-SIZE="14">voice click, play, drag, ripple</FONT>>, fillcolor="#eaf8ef:#ffffff", color="#22865a"];
    Q [label=<<B>Command queue</B>>, shape=cylinder, fillcolor="#eaf8ef:#ffffff", color="#22865a", height=0.85];
    K -> Q;
    P -> Q;
  }

  // ---- Audio scheduler (audio clock, off-frame) ----
  subgraph cluster_scheduler {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#0f766e"><B>AUDIO SCHEDULER  (setInterval, audio clock)</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#357a74">Schedules each note at its exact AudioContext time ~0.15 s ahead.</FONT></TD></TR>
        </TABLE>
      >,
      labelloc=t, labeljust=l, color="#99d5cf", fillcolor="#f0fdfa", style="rounded,filled", penwidth=1.8, margin=18
    ];
    SS [label=<<B>engine.step</B><BR/><FONT POINT-SIZE="14">one grid step → notes</FONT>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];
    SN [label=<<B>spawn_note</B><BR/><FONT POINT-SIZE="14">schedule at audio time</FONT>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];
    SS -> SN;
  }

  // ---- frame(): render clock ----
  subgraph cluster_frame {
    graph [
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#9a7400"><B>frame()  (requestAnimationFrame)</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#a98a3a">Ordered systems; fixed order is the contract.</FONT></TD></TR>
        </TABLE>
      >,
      labelloc=t, labeljust=l, color="#f3dd9a", fillcolor="#fffdf5", style="rounded,filled", penwidth=1.8, margin=18
    ];
    F1 [label=<<B>apply_input_commands</B>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    F2 [label=<<B>update_pulses</B>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    F3 [label=<<B>update_swirl_and_fx</B>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    F4 [label=<<B>update_spatial_audio</B>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    F5 [label=<<B>update_ambient</B>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    F6 [label=<<B>render_scene</B>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    F1 -> F2 -> F3 -> F4 -> F5 -> F6;
  }

  // ---- Shared state / resources ----
  E  [label=<<B>Music engine</B><BR/><FONT POINT-SIZE="14">params, voices, seeded RNGs</FONT>>, fillcolor="#eaf8ef:#ffffff", color="#22865a"];
  PQ [label=<<B>Pulse queue</B><BR/><FONT POINT-SIZE="14">(voice, audio time, vel)</FONT>>, shape=cylinder, fillcolor="#e6fffb:#ffffff", color="#0f766e", height=0.9];
  AU [label=<<B>Web Audio graph</B>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];
  NP [label=<<B>Note pool</B><BR/><FONT POINT-SIZE="14">reap + cap</FONT>>, fillcolor="#e6fffb:#ffffff", color="#0f766e"];
  G  [label=<<B>WebGPU renderer</B>>, fillcolor="#f5f3ff:#ffffff", color="#7c3aed"];

  { rank=same; SS; E; }
  { rank=same; SN; F1; }

  // ---- Edges ----
  Q -> F1 [label="drain", lhead=cluster_frame];
  E -> SS [label="step", dir=both, ltail=cluster_scheduler];
  F1 -> E [label="root / mode / tempo / mute…", style=dashed, color="#6b7280", fontcolor="#6b7280"];
  SN -> AU [label="oscillator + gain"];
  SN -> NP [label="track"];
  SN -> PQ [label="timed pulse"];
  PQ -> F2 [label="fire when due"];
  F3 -> AU [label="reverb / delay / saturation", constraint=false];
  F4 -> AU [label="panner + sends", constraint=false];
  F5 -> G [label="ambient clear", style=dashed, color="#6b7280", fontcolor="#6b7280", constraint=false];
  F6 -> G [label="swirl, ripple, render"];
  NP -> AU [style=dashed, color="#6b7280", constraint=false];
}
